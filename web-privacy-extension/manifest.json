{
   "action": {
      "default_icon": {
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png",
         "128": "icon128.png"
      },
      "default_popup": "popup.html",
      "default_title": "__MSG_actionTitle__"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "cleanup-now": {
         "description": "__MSG_commandCleanupNow__",
         "suggested_key": {
            "default": "Alt+Shift+K"
         }
      }
   },
   "content_scripts": [
      {
         "js": [
            "content.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_idle"
      }
   ],
   "description": "__MSG_extDescription__",
   "host_permissions": [
      "<all_urls>"
   ],
   "icons": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
   },
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "options_page": "options.html",
   "permissions": [
      "browsingData",
      "storage",
      "alarms",
      "notifications"
   ],
   "version": "1.2.0",
   "default_locale": "en"
}
