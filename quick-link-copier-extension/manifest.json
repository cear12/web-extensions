{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy current page URL"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "description": "One-click link copying with history.",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png"
  },
  "manifest_version": 3,
  "name": "QuickLink Copier",
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "version": "1.1.2"
}
