{
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "description": "__MSG_appDescription__",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png"
  },
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite",
    "scripting",
    "notifications",
    "offscreen"
  ],
  "version": "1.1.5",
  "minimum_chrome_version": "109",
  "default_locale": "en"
}
