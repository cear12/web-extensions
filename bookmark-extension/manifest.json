{
  "manifest_version": 3,
  "name": "File Bookmarks (TXT / MD)",
  "version": "1.0.0",
  "description": "Bookmark your place in a TXT or Markdown file opened in Chrome and jump straight back to it next time you open the same file.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "File Bookmarks"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "tabs"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
