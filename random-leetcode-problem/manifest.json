{
  "manifest_version": 3,
  "name": "Random LeetCode Problem",
  "version": "1.0.0",
  "description": "Get a random free LeetCode problem to practice, with difficulty filtering and local caching.",
  "action": {
    "default_title": "Random LeetCode Problem",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ]
}
